# macOS
.DS_Store

# Node (workspace dev-dependencies only; template must stay dependency-free)
node_modules/

# Test outputs and scratch
tmp/
*.log
tests/**/output/
tests/**/*.actual

# Forge cache local (locks, estado efêmero)
.forge/cache/

# Worktrees do harness. O bloco managed que o installer entrega (installer/gitignore.patch) já
# ignora este caminho em todo projeto que instala o Forge; este repositório é a FONTE do bloco e
# não o aplica em si mesmo, então o padrão precisa existir aqui explicitamente. Sem ele, abrir um
# worktree pelo fluxo do próprio harness deixa a árvore suja.
.forge/worktrees/

# Scratch de agente/revisão — diretórios que subagentes criam na raiz ao reproduzir casos.
# Entraram uma vez no repositório por `git add -A` sem conferência (commit 37754e6).
/x/
/dummy/
/probe*/
/scratch/

# Estado local de ferramenta externa de code graph (índice SQLite de ~7 MB, regenerável).
# Tem .gitignore próprio para o .db, mas o próprio diretório não deve entrar aqui — o índice é
# por máquina, e o grafo que este repositório versiona é o do Forge, em .forge/graph/.
/.codegraph/
