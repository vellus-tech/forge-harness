 package br.com.axis.posrecarga.domain
 
 import kotlinx.coroutines.test.runTest
+import org.junit.Assert.assertEquals
 import org.junit.Assert.assertTrue
 import org.junit.Test
 
@@ -10,11 +11,68 @@ class CompleteRechargeUseCaseTest {
             PaymentApproval.Approved("4111111111111111", "000123", "A1B2C3", 1_700_000_000_000)
     }
 
+    private class FakePrinterPort(
+        private val status: PrinterStatus,
+    ) : PrinterPort {
+        var printedLines: List<String>? = null
+            private set
+
+        override suspend fun status(): PrinterStatus = status
+
+        override suspend fun print(lines: List<String>): PrintResult {
+            if (status !is PrinterStatus.Ready) return PrintResult.Unavailable(status)
+            printedLines = lines
+            return PrintResult.Printed
+        }
+    }
+
     @Test
     fun `approved payment yields receipt`() = runTest {
-        val outcome = CompleteRechargeUseCase(approvedGateway)(
+        val outcome = CompleteRechargeUseCase(approvedGateway, FakePrinterPort(PrinterStatus.Ready))(
             RechargeRequest("corr-1", "T-01", "04A1B2C3", 1_000),
         )
         assertTrue(outcome is RechargeOutcome.Approved)
     }
+
+    @Test
+    fun `approved payment prints receipt when printer is ready`() = runTest {
+        val printer = FakePrinterPort(PrinterStatus.Ready)
+
+        val outcome = CompleteRechargeUseCase(approvedGateway, printer)(
+            RechargeRequest("corr-1", "T-01", "04A1B2C3", 1_000),
+        )
+
+        val approved = outcome as RechargeOutcome.Approved
+        assertEquals(PrintResult.Printed, approved.printResult)
+        assertEquals(ReceiptFormatter.format(approved.receipt), printer.printedLines)
+    }
+
+    @Test
+    fun `approved payment stays approved when printer is out of paper`() = runTest {
+        val printer = FakePrinterPort(PrinterStatus.OutOfPaper)
+
+        val outcome = CompleteRechargeUseCase(approvedGateway, printer)(
+            RechargeRequest("corr-1", "T-01", "04A1B2C3", 1_000),
+        )
+
+        val approved = outcome as RechargeOutcome.Approved
+        assertEquals(PrintResult.Unavailable(PrinterStatus.OutOfPaper), approved.printResult)
+        assertTrue(printer.printedLines == null)
+    }
+
+    @Test
+    fun `declined payment never reaches the printer`() = runTest {
+        val declinedGateway = object : PaymentGatewayPort {
+            override suspend fun authorize(request: RechargeRequest) =
+                PaymentApproval.Denied("insufficient_funds")
+        }
+        val printer = FakePrinterPort(PrinterStatus.Ready)
+
+        val outcome = CompleteRechargeUseCase(declinedGateway, printer)(
+            RechargeRequest("corr-1", "T-01", "04A1B2C3", 1_000),
+        )
+
+        assertTrue(outcome is RechargeOutcome.Declined)
+        assertTrue(printer.printedLines == null)
+    }
 }
