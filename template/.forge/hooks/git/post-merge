#!/usr/bin/env bash
# Forge post-merge (§20.4) — after a merge into the integration branch:
#   1. prunes dead worktree refs and removes CLEAN worktrees whose branch is already merged
#      into HEAD (mandatory cleanup, §20.4/v3.1);
#   2. accumulates the merged branch's conventional commits into the root CHANGELOG.md
#      ([Unreleased], Keep a Changelog) — no-op when there is no root CHANGELOG.md;
#   3. suggests promotion to staging when running on the integration branch.
# Informational hook — o git IGNORA o exit status do post-merge, então falhar aqui não desfaz o
# merge; o que muda é o DESFECHO OBSERVÁVEL: uma delegação quebrada passa a ter linha própria e
# exit≠0, em vez de sair pelo mesmo "post-merge OK" de uma execução bem-sucedida (issue #49).
set -u

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT" || exit 0

git worktree prune 2>/dev/null || true

# changelog (§20.4): acumula commits convencionais do merge no CHANGELOG.md raiz.
# Determinista/idempotente; no-op sem CHANGELOG.md raiz ou se HEAD não for um merge.
#
# Regra de delegação (issue #49, instância 4): chamar algo que não existe é ERRO, não no-op.
# O no-op só é legítimo quando o harness NÃO está instalado — aí não há maquinaria a impor. Se o
# DIRETÓRIO que hospeda o alvo existe, a ausência do alvo significa harness atualizado pela
# metade, script apagado ou instalação corrompida, e isso não pode terminar no mesmo desfecho de
# uma execução bem-sucedida.
CHANGELOG_GEN="$ROOT/.forge/scripts/lib/changelog-from-merge.mjs"
delegation_failed=0
if [ -f "$CHANGELOG_GEN" ]; then
  if command -v node >/dev/null 2>&1; then
    # A saída de erro deixou de ir para /dev/null: `2>/dev/null || true` fazia uma falha do
    # gerador sair idêntica a um no-op bem-sucedido — o mesmo colapso de estados, um nível abaixo.
    if ! gen_out="$(node "$CHANGELOG_GEN" "$ROOT" 2>&1)"; then
      echo "post-merge FALHOU: changelog-from-merge.mjs terminou com erro:" >&2
      printf '%s\n' "$gen_out" | sed 's/^/  /' >&2
      delegation_failed=1
    fi
  fi
elif [ -d "$ROOT/.forge/scripts/lib" ]; then
  echo "post-merge FALHOU: .forge/scripts/lib/ existe mas changelog-from-merge.mjs não —" >&2
  echo "  a delegação aponta para um alvo ausente, e isso não pode sair como sucesso." >&2
  delegation_failed=1
fi

# ── worktrees mergeadas (issue #72) ──────────────────────────────────────────────────────────────
# PROPÕE, não remove. O default era remover, e isso destruiu trabalho de verdade: no merge de um PR
# real, uma worktree e a branch local sumiram sozinhas, levando junto `local.properties` e `build/`.
#
# A raiz do defeito está numa frase que parece verdadeira e não é: "worktree limpa". `git status
# --porcelain` NÃO vê arquivo ignorado, e `git branch -d` não protege o que não está no índice —
# então uma worktree cheia de estado local irrecuperável satisfaz o critério de "limpa" e é
# removida. O que o git rastreia e o que existe no disco são conjuntos diferentes, e a remoção
# destrói a diferença.
#
# O default invertido também é o que a comunidade escolheu sozinha: três de quatro consumidores de
# um mesmo ecossistema desligaram esta limpeza por conta própria, em formulações mutuamente
# incompatíveis. Como `hooks/` é sobrescrito pelo overlay do `update`, cada upgrade REVERTIA essa
# decisão em silêncio — e ninguém revisa diff de maquinaria depois de um upgrade.
#
# Ligar de volta é `FORGE_WORKTREE_AUTOCLEAN=1`, e mesmo ligado a guarda de arquivo ignorado
# permanece: é exatamente ali que o dano ocorreu, e ele não é detectável depois.
autoclean="${FORGE_WORKTREE_AUTOCLEAN:-0}"
removed=0; proposed=0; proposta=""
while IFS= read -r wt; do
  [ -n "$wt" ] || continue
  case "$wt" in
    "$ROOT"/.forge/worktrees/*)
      branch="$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
      [ -n "$branch" ] && [ "$branch" != "HEAD" ] || continue
      git merge-base --is-ancestor "$branch" HEAD 2>/dev/null || continue
      [ -z "$(git -C "$wt" status --porcelain 2>/dev/null)" ] || continue
      # A guarda que faltava. `git clean -ndX` lista o que está IGNORADO e presente — o estado que
      # `status --porcelain` não enxerga e que a remoção apagaria sem recuperação possível.
      ign="$(git -C "$wt" clean -ndX 2>/dev/null | head -3)"
      if [ -n "$ign" ]; then
        proposed=$((proposed + 1))
        proposta="$proposta
  · $wt (branch $branch, já em HEAD) — NÃO removida: tem arquivo ignorado presente
    $(printf '%s' "$ign" | sed 's/^/      /')
      remover mesmo assim: git worktree remove --force '$wt' && git branch -d '$branch'"
        continue
      fi
      if [ "$autoclean" = "1" ]; then
        if git worktree remove "$wt" 2>/dev/null; then
          removed=$((removed + 1))
          git branch -d "$branch" 2>/dev/null || true
        fi
      else
        proposed=$((proposed + 1))
        proposta="$proposta
  · $wt (branch $branch, já em HEAD)
      git worktree remove '$wt' && git branch -d '$branch'"
      fi
      ;;
  esac
done <<EOF_WT
$(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2}' | tail -n +2)
EOF_WT
if [ "$proposed" -gt 0 ]; then
  echo "post-merge: $proposed worktree(s) mergeada(s) — proponho remover (nada foi removido):"
  printf '%s\n' "$proposta"
  [ "$autoclean" = "1" ] || echo "  (remover automaticamente: FORGE_WORKTREE_AUTOCLEAN=1)"
fi

current="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
if [ "$delegation_failed" -ne 0 ]; then
  echo "post-merge INCOMPLETO (worktrees removidas: $removed, propostas: $proposed) — ver a falha de delegação acima." >&2
  exit 1
fi
msg="post-merge OK (worktrees removidas: $removed, propostas: $proposed)"
[ "$current" = "develop" ] && msg="$msg — considere /forge:promote-staging quando develop estiver estável"
echo "$msg"
exit 0
