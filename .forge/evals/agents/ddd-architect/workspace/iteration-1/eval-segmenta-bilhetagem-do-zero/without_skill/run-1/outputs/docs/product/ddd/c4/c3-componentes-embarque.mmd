flowchart TB
    subgraph embarque_svc["embarque-svc"]
        API["API gRPC de Decisão de Embarque"]
        MOTOR["Motor de Tarifação<br/>(tarifa vigente + integração 60min)"]
        PROJ["Projeção Local de Saldo/Bloqueio<br/>(réplica offline)"]
