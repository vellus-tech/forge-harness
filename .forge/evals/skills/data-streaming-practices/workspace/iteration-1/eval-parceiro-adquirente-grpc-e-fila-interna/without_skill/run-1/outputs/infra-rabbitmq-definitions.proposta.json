{
  "vhosts": [{ "name": "pagamentos" }],
  "users": [
    { "name": "svc-autorizador", "password_hash": "<gerenciado-pelo-vault>", "hashing_algorithm": "rabbit_password_hashing_sha256", "tags": [] },
    { "name": "svc-conciliacao", "password_hash": "<gerenciado-pelo-vault>", "hashing_algorithm": "rabbit_password_hashing_sha256", "tags": [] },
    { "name": "svc-conciliacao-parceiro", "password_hash": "<gerenciado-pelo-vault>", "hashing_algorithm": "rabbit_password_hashing_sha256", "tags": [] }
  ],
  "permissions": [
    { "user": "svc-autorizador", "vhost": "pagamentos", "configure": "^$", "write": "^pagamentos\\.eventos$", "read": "^$" },
    { "user": "svc-conciliacao", "vhost": "pagamentos", "configure": "^$", "write": "^$", "read": "^conciliacao\\." },
    { "user": "svc-conciliacao-parceiro", "vhost": "pagamentos", "configure": "^$", "write": "^$", "read": "^conciliacao\\.parceiro$" }
  ],
  "exchanges": [
    { "name": "pagamentos.eventos", "vhost": "pagamentos", "type": "topic", "durable": true, "auto_delete": false, "arguments": {} }
  ],
  "queues": [
    { "name": "conciliacao.transacoes", "vhost": "pagamentos", "durable": true, "auto_delete": false, "arguments": { "x-queue-type": "quorum" } },
    { "name": "conciliacao.parceiro", "vhost": "pagamentos", "durable": true, "auto_delete": false, "arguments": { "x-queue-type": "quorum", "x-dead-letter-exchange": "pagamentos.eventos.dlx" } }
  ],
  "bindings": [
    { "source": "pagamentos.eventos", "vhost": "pagamentos", "destination": "conciliacao.transacoes", "destination_type": "queue", "routing_key": "transacao.autorizada", "arguments": {} },
    { "source": "pagamentos.eventos", "vhost": "pagamentos", "destination": "conciliacao.parceiro", "destination_type": "queue", "routing_key": "transacao.autorizada", "arguments": {} }
  ]
}
