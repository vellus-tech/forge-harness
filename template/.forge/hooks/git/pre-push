#!/usr/bin/env bash
# Forge pre-push (§20.4) — runs the project's own typecheck + tests (as declared in the
# FORGE.md frontmatter `runtime:` block) before pushing a work branch. Empty commands are
# skipped (greenfield). Raw output goes to /tmp (context-overflow discipline §17.6).
set -u

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

# Consume stdin (git feeds "<local ref> <local sha> <remote ref> <remote sha>" lines)
# before anything else touches it, and run the docs-reviewed gate. This check is
# independent of .forge/FORGE.md — it applies to any repo using this hook.
INPUT="$(cat)"
# Re-export the raw refs for gates declared in runtime.gates. Without this, a gate that needs to
# know WHAT is being published only sees what's in checkout — and the two diverge on
# `git push origin other-branch:main` and on multi-ref pushes, where a gate resolving its target
# via `git rev-parse HEAD` would validate the wrong commit. The hook's stdin can only be consumed
# once; this is the only way what arrived on it reaches gate scripts downstream.
#
# Via a FILE, never the payload itself in the environment. The payload is unbounded (`git push
# --all` on a repo with thousands of refs) and the kernel caps a SINGLE environment string at
# 128 KB on Linux (MAX_ARG_STRLEN). Past that every exec inside this hook fails with E2BIG —
# including the awk that reads FORGE.md — so the hook finds no typecheck, no test and no gates,
# prints "pre-push OK" and exits 0 having verified nothing. Fail-open on the largest pushes is
# the worst possible failure mode for a gate. A path is a few dozen bytes and never gets near
# the cap. Covered by tests/w135-push-refs-export-gate.sh, scenarios [3] and [4].
FORGE_PUSH_REFS_FILE="$(mktemp "${TMPDIR:-/tmp}/forge-pushrefs-XXXXXX")"
export FORGE_PUSH_REFS_FILE
trap 'rm -f "$FORGE_PUSH_REFS_FILE"' EXIT
# An empty stdin (nothing being pushed) writes an EMPTY file, not a blank line: a gate must be
# able to tell "zero refs" from "one ref I failed to parse".
if [ -n "$INPUT" ]; then printf '%s\n' "$INPUT" > "$FORGE_PUSH_REFS_FILE"; else : > "$FORGE_PUSH_REFS_FILE"; fi
# Regra de delegação (issue #49, instância 4): chamar algo que não existe é ERRO, não no-op.
# O no-op só é legítimo quando o harness NÃO está instalado — aí não há maquinaria a impor. Se o
# DIRETÓRIO que hospeda o alvo existe, a ausência do alvo significa harness atualizado pela
# metade, script apagado ou instalação corrompida, e isso não pode terminar no mesmo desfecho de
# uma execução bem-sucedida.
HOOK_LIB_DIR="$ROOT/.forge/hooks/git/lib"
require_hook_lib() {  # require_hook_lib <path> — 0 = existe e deve ser sourced; 1 = no-op legítimo
  [ -f "$1" ] && return 0
  [ -d "$HOOK_LIB_DIR" ] || return 1
  echo "pre-push BLOQUEADO: $HOOK_LIB_DIR existe mas $(basename "$1") não —" >&2
  echo "  a delegação aponta para um alvo ausente. Rode /forge:upgrade ou restaure a lib." >&2
  exit 1
}

DOCS_LIB="$HOOK_LIB_DIR/check-docs-reviewed.sh"
if require_hook_lib "$DOCS_LIB"; then
  # shellcheck disable=SC1090
  . "$DOCS_LIB"
  if ! printf '%s\n' "$INPUT" | REPO="$ROOT" check_docs_reviewed; then
    exit 1
  fi
fi

# red-first (rule testing/regression-red-first.md) — check ESTÁTICO só (nunca roda teste; o
# replay caro fica para /forge:red replay e para /forge:verify).
RED_LIB="$HOOK_LIB_DIR/check-red-first.sh"
if require_hook_lib "$RED_LIB"; then
  # shellcheck disable=SC1090
  . "$RED_LIB"
  if ! printf '%s\n' "$INPUT" | REPO="$ROOT" check_red_first; then
    exit 1
  fi
fi

# no-ai-attribution (rule conventions/no-ai-attribution.md) — varre os commits que estão sendo
# publicados. Defesa em profundidade sobre o hook commit-msg: aqui pega o que nasceu com
# --no-verify, o que veio de outra ferramenta, e o que foi importado por cherry-pick de um branch
# marcado. É a última fronteira antes de a marca virar histórico público, onde removê-la deixa de
# ser problema de quem commitou e passa a ser problema de todo mundo que tem clone.
AI_CHECK="$ROOT/.forge/scripts/check-ai-attribution.sh"
if [ ! -f "$AI_CHECK" ] && [ -d "$ROOT/.forge/scripts" ]; then
  echo "pre-push BLOQUEADO: .forge/scripts/ existe mas check-ai-attribution.sh não — delegação em alvo ausente" >&2
  exit 1
fi
if [ -f "$AI_CHECK" ]; then
  while read -r _lref lsha _rref rsha; do
    [ -n "${lsha:-}" ] || continue
    case "$lsha" in *[!0]*) : ;; *) continue ;; esac   # deleção de ref: nada a varrer
    if [ -z "${rsha:-}" ] || [ "$rsha" = "0000000000000000000000000000000000000000" ]; then
      # ref nova no remoto: limita ao que este branch traz além dos demais refs conhecidos.
      #
      # `<oldest>~1` NÃO existe quando o commit mais antigo do branch é o commit RAIZ — o caso de
      # todo repositório recém-criado. O range ficava inválido, `git rev-list` devolvia vazio, e o
      # gate reportava-se verde tendo varrido zero commit: exatamente o "não executei e executei
      # limpo terminam no mesmo exit 0" da issue #49, que só apareceu quando o contador de
      # controle passou a reprovar conjunto vazio. Quando o pai não existe, o range correto é o
      # próprio sha (todos os commits alcançáveis).
      oldest="$(git rev-list "$lsha" --not --remotes 2>/dev/null | tail -1)"
      if [ -n "$oldest" ] && git rev-parse --verify --quiet "$oldest~1" >/dev/null 2>&1; then
        range="$oldest~1..$lsha"
      else
        range="$lsha"
      fi
    else
      range="$rsha..$lsha"
    fi
    if ! bash "$AI_CHECK" range "$range" >/dev/null; then
      echo "pre-push BLOQUEADO: no-ai-attribution (rule conventions/no-ai-attribution.md)" >&2
      bash "$AI_CHECK" range "$range" || true
      exit 1
    fi
  done <<EOF_AI
$INPUT
EOF_AI
fi

# liaison acks (rule conventions/liaison-protocol.md) — cobra só os acks que ESTE repositório deve.
# Roda antes do gate de FORGE.md porque não depende dele: um repositório pode ter canal de liaison
# sem ter o bloco runtime configurado, e a cobrança de contrato vale igual.
ACKS="$ROOT/.forge/scripts/check-liaison-acks.sh"
if [ ! -f "$ACKS" ] && [ -d "$ROOT/.forge/scripts" ]; then
  echo "pre-push BLOQUEADO: .forge/scripts/ existe mas check-liaison-acks.sh não — delegação em alvo ausente" >&2
  exit 1
fi
if [ -f "$ACKS" ]; then
  if ! FORGE_ROOT="$ROOT" bash "$ACKS"; then
    echo "pre-push BLOQUEADO: liaison — ack pendente (rule conventions/liaison-protocol.md)" >&2
    exit 1
  fi
fi

# liaison log integrity (issue #80) — o BLOQUEIO do único modo de falha do merge=union: nada
# duplicado sai da máquina QUANDO o check roda e acha duplicata. post-merge (abaixo, neste mesmo
# diretório) já DETECTA no instante em que a duplicata nasce e roda em qualquer branch; este é o
# segundo dos dois pontos de fiação que a issue pede — nenhum dos dois basta sozinho.
#
# Alvo AUSENTE aqui NÃO bloqueia (mesma classe de check-worktree-prereqs.sh acima, issue #81, e
# pelo MESMO motivo: `core.hooksPath` absoluto compartilha este hook entre TODOS os worktrees, mas
# `.forge/scripts/` é conteúdo PRÓPRIO de cada um (issue #41) — uma worktree que ainda não trouxe
# o commit deste script, mas herda o hook novo de outra, bloquearia por causa alheia, e é
# exatamente a classe que a issue #73 corrigiu. `warn`, não `block`: nomeia a lacuna em voz alta
# (o "não verifiquei" de #49 continua visível, nunca silêncio), mas não trava quem não tem como
# resolvê-la só empurrando de novo. Quando o script EXISTE e RODA, a política é enforçada de
# verdade — é só a ausência do alvo que degrada para aviso.
LOG_INTEGRITY="$ROOT/.forge/scripts/check-liaison-log-integrity.sh"
if [ -f "$LOG_INTEGRITY" ]; then
  if ! FORGE_ROOT="$ROOT" bash "$LOG_INTEGRITY"; then
    echo "pre-push BLOQUEADO: liaison — log duplicado pelo merge=union (issue #80)" >&2
    exit 1
  fi
elif [ -d "$ROOT/.forge/scripts" ]; then
  echo "pre-push: liaison-log-integrity (issue #80) NÃO VERIFICADO — check-liaison-log-integrity.sh ausente em .forge/scripts/ (rode 'npx forge-harness update' para instalar). merge=union nunca perde mensagem, só duplica, e post-merge (quando presente) já teria sinalizado — mas esta checagem específica não rodou agora."
fi

FORGE_MD="$ROOT/.forge/FORGE.md"
[ -f "$FORGE_MD" ] || { echo "pre-push OK (sem harness)"; exit 0; }

# ── pré-condições de worktree (issue #81) ────────────────────────────────────────────────────
# ANTES de qualquer suíte, e ANTES do mutex de carga pesada: enumera de uma vez todo artefato de
# árvore (deps instaladas, build declarado) que os gates abaixo vão precisar e este hook não
# produz. Medido em campanha real: sem isto, cada pendência só aparece depois que a anterior é
# corrigida e um NOVO ciclo de push é gasto para descobri-la — 9 tentativas, 0 por defeito de
# código. Três saídas foram comparadas (produzir o artefato; degradar para aviso; revelar todas
# de uma vez) — revelar todas é a única que corta o custo medido sem herdar o risco de rodar
# install/build como efeito colateral de um push. Só `existsSync`/`readFileSync` — nunca install,
# nunca build — para não ficar mais caro que o hook que substitui no caminho feliz.
#
# Alvo ausente aqui NÃO bloqueia (diferente de DOCS_LIB/RED_LIB/AI_CHECK/ACKS/HARNESS_SUITE acima
# e abaixo). A diferença não é capricho: aqueles enforçam POLÍTICA — se o alvo sumir, uma checagem
# real deixa de rodar e algo passaria que não devia (issue #49: silêncio ali é dano). Este preflight
# não enforça política nenhuma própria — só antecipa, de forma consolidada, o que os gates ABAIXO
# (typecheck/test/gates/harness-tests) já reprovariam um de cada vez se algo faltar. Ausente, a
# cobertura de correção não muda: só se perde a conveniência de ver tudo junto — voltar ao
# comportamento pré-#81, nunca pior que ele. E bloquear aqui reintroduziria a #73 por outro
# caminho: `check-worktree-prereqs.sh` chega junto com este hook num `forge update` completo (os
# dois moram em MACHINERY_DIRS e são copiados no mesmo passo), mas hooks podem ser compartilhados
# entre worktrees por `core.hooksPath` absoluto enquanto `.forge/scripts/` é conteúdo PRÓPRIO de
# cada worktree (issue #41) — uma worktree que ainda não trouxe o commit com o script novo, mas
# herda o hook novo de outra, bloquearia por causa alheia. `warn`, não `block`: nomeia a lacuna em
# voz alta (nunca silêncio — o "não verifiquei" de #49 continua visível), mas não trava quem não
# tem como resolvê-la só empurrando de novo.
PREREQS="$ROOT/.forge/scripts/check-worktree-prereqs.sh"
if [ -f "$PREREQS" ]; then
  if ! PREREQS_OUT="$(bash "$PREREQS" --path "$ROOT" 2>&1)"; then
    echo "pre-push BLOQUEADO: pré-condições de worktree ausentes (issue #81) —"
    echo "$PREREQS_OUT"
    exit 1
  fi
elif [ -d "$ROOT/.forge/scripts" ]; then
  echo "pre-push: worktree-prereqs (issue #81) NÃO VERIFICADO — check-worktree-prereqs.sh ausente em .forge/scripts/ (rode 'npx forge-harness update' para instalar). Os gates abaixo ainda reprovam se algo faltar — só não juntos."
fi

fm_field() {  # fm_field <key> — value of "  <key>:" inside the runtime: block
  awk -v key="$1" '
    /^runtime:/ { inblk=1; next }
    inblk && /^[a-z_]+:/ { exit }
    inblk && $0 ~ "^  "key":" { sub("^  "key":[[:space:]]*", ""); print; exit }
  ' "$FORGE_MD"
}

gate_deps_ready() {  # gate_deps_ready <cmd> — false quando o gate depende de deps Node ainda não instaladas
  # Um gate JS (pnpm/npm/npx/yarn) num clone recém-feito falha porque `node_modules` não existe —
  # isso não é um erro de código, é infra ausente (§20.4). Degradar com elegância: avisar + pular,
  # deixando o typecheck pesado para /forge:verify. Toolchains não-JS seguem inalterados.
  case "$1" in
    *pnpm*|*npm*|*npx*|*yarn*)
      [ -d "$ROOT/node_modules" ] && return 0
      return 1 ;;
  esac
  return 0
}

run_check() {  # run_check <label> <cmd>
  local label="$1" cmd="$2" log
  [ -n "$cmd" ] || { echo "pre-push: $label não definido — skip"; return 0; }
  if ! gate_deps_ready "$cmd"; then
    echo "pre-push: $label PULADO — node_modules/ ausente (rode 'pnpm install' ou deixe para /forge:verify)"
    return 0
  fi
  # NB: o template do mktemp precisa TERMINAR nos X (BSD/macOS falha com sufixo após o X, ex.:
  # `-XXXXXX.log`). Sem sufixo de extensão — é um arquivo de log temporário efêmero.
  log="$(mktemp "${TMPDIR:-/tmp}/forge-prepush-XXXXXX")"
  if (cd "$ROOT" && eval "$cmd") >"$log" 2>&1; then
    echo "pre-push: $label OK"
  else
    echo "pre-push BLOQUEADO: $label falhou — tail:"
    tail -20 "$log"
    exit 1
  fi
}

# ── mutex de carga pesada (issue #52) ─────────────────────────────────────────────────────────
# Adquirido em volta do que é CARO (typecheck, test, gates), nunca em volta dos checks baratos
# acima: docs-reviewed, red-first estático e ai-attribution devem falhar rápido SEM ocupar a
# máquina. A ordem do hook é a disciplina "build verde antes de entrar na fila" imposta por
# construção — medido em campo, 1305 segundos de fila para descobrir um erro de 8 segundos.
#
# Só engaja com `heavy_mutex.enabled: true` no forge.yaml. O default é desligado porque o harness
# é publicado no npm e instalado por terceiros: chegar serializando o pre-push de repositórios não
# relacionados é como um gate vira `--no-verify` de hábito.
HEAVY_LIB="$ROOT/.forge/scripts/lib/heavy-mutex.sh"
if [ ! -f "$HEAVY_LIB" ] && [ -d "$ROOT/.forge/scripts/lib" ]; then
  echo "pre-push BLOQUEADO: .forge/scripts/lib/ existe mas heavy-mutex.sh não — delegação em alvo ausente." >&2
  exit 1
fi
_heavy_enabled() {
  [ -f "$ROOT/.forge/forge.yaml" ] || return 1
  awk '/^heavy_mutex:/{f=1;next} f&&/^[a-z]/{f=0} f&&/^[[:space:]]*enabled:[[:space:]]*true/{print "y";exit}' \
    "$ROOT/.forge/forge.yaml" 2>/dev/null | grep -q y
}
if [ -f "$HEAVY_LIB" ] && _heavy_enabled; then
  # shellcheck disable=SC1090
  . "$HEAVY_LIB"
  forge_heavy_mutex_acquire --label "pre-push de $(basename "$ROOT")" || exit $?
  forge_heavy_mutex_arm_trap
fi

# ── lints de shell, por DIFF (LDG-0069) ──────────────────────────────────────────────────────
# `check-shell-pipeline.sh` e `check-heredoc-hash.sh` já rodavam no CI contra o corpus real —
# `w145[8]`, `w159[8]` e o passo dedicado do `ci.yml`. O que faltava não era cobertura, era
# LATÊNCIA: o autor descobria a violação depois de empurrar. Aqui a descoberta passa a ser antes.
#
# Por DIFF, nunca pela árvore: os próprios gates `w145`/`w159` montam fixtures que CONTÊM de
# propósito a forma proibida (construídas por concatenação, para não se autodetectarem), e um
# hook que varresse tudo indiscriminadamente bloquearia o push da própria entrega. Só os `.sh`
# que este push publica são varridos.
#
# NÃO entra no `pre-commit`: varrer o corpus a cada commit não se justifica para uma classe que o
# CI já pega, e um hook lento é um hook desativado.
SHELL_LINTS="check-shell-pipeline check-heredoc-hash"
if [ -d "$ROOT/.forge/scripts" ]; then
  _sh_list="$(mktemp "${TMPDIR:-/tmp}/forge-shlint-XXXXXX")"
  # UMA chamada de git para o push inteiro, nunca uma por ref. `git log` aceita vários intervalos
  # de revisão de uma vez e devolve a união — e o custo por ref é justamente o que `w152[31]`
  # guarda por RAZÃO (medido: um `git` a mais por ref levou a suíte daquele gate de dentro do
  # orçamento para 313s de um teto de 240s). Um `git push --all` com centenas de refs continua
  # custando uma invocação.
  _revs=()
  while read -r _lref lsha _rref rsha; do
    [ -n "${lsha:-}" ] || continue
    case "$lsha" in *[!0]*) : ;; *) continue ;; esac   # deleção de ref: nada a varrer
    if [ -z "${rsha:-}" ] || [ "$rsha" = "0000000000000000000000000000000000000000" ]; then
      _revs+=("$lsha")            # ref nova: tudo que ela alcança
    else
      _revs+=("$rsha..$lsha")     # ref existente: só o que este push acrescenta
    fi
  done <<EOF_SHL
$INPUT
EOF_SHL
  if [ "${#_revs[@]}" -gt 0 ]; then
    git -C "$ROOT" log --format= --name-only "${_revs[@]}" -- '*.sh' '*.bash' > "$_sh_list" 2>/dev/null || : > "$_sh_list"
  fi
  _sh_n=0
  _sh_args=()
  while IFS= read -r _f; do
    [ -n "$_f" ] || continue
    [ -f "$ROOT/$_f" ] || continue          # arquivo apagado pelo push não tem o que linTar
    case " ${_sh_args[*]:-} " in *" $ROOT/$_f "*) continue ;; esac
    _sh_args+=("--path" "$ROOT/$_f")
    _sh_n=$((_sh_n + 1))
  done < "$_sh_list"
  rm -f "$_sh_list"
  if [ "$_sh_n" -eq 0 ]; then
    # Sinal POSITIVO do caminho "não havia o que varrer": "não rodei" e "rodei e estava limpo"
    # não podem terminar no mesmo silêncio (issue #49).
    echo "pre-push: shell-lints — 0 arquivo(s) .sh no diff publicado; nada a varrer"
  else
    echo "pre-push: shell-lints — $_sh_n arquivo(s) .sh no diff publicado"
    # Delegação em alvo ausente é ERRO — mas só quando há o que varrer. A guarda vive AQUI, e não
    # no topo do bloco, de propósito: um push que não publica `.sh` nenhum não tem cobertura a
    # perder por o lint estar ausente, e bloqueá-lo transformaria a instalação parcial de uma
    # worktree (issue #73: hooks compartilhados por `core.hooksPath` absoluto, `.forge/scripts/`
    # conteúdo próprio de cada uma) em push travado por causa alheia. Com `.sh` no diff, a
    # ausência do lint é cobertura que some em silêncio, e aí bloqueia.
    for _l in $SHELL_LINTS; do
      _s="$ROOT/.forge/scripts/$_l.sh"
      if [ ! -f "$_s" ]; then
        echo "pre-push BLOQUEADO: este push publica $_sh_n arquivo(s) .sh e .forge/scripts/$_l.sh não existe." >&2
        echo "  Delegação em alvo ausente: o lint que varreria esses arquivos sumiu, e seguir devolveria" >&2
        echo "  push verde sem varredura nenhuma. Rode 'npx forge-harness update' ou restaure o lint." >&2
        exit 1
      fi
      if ! _lint_out="$(FORGE_ROOT="$ROOT" bash "$_s" "${_sh_args[@]}" 2>&1)"; then
        echo "pre-push BLOQUEADO: $_l reprovou nos .sh que este push publica —" >&2
        printf '%s\n' "$_lint_out" >&2
        exit 1
      fi
    done
    echo "pre-push: shell-lints OK — $_sh_n arquivo(s) .sh varrido(s) por $SHELL_LINTS"
  fi
fi

run_check "typecheck" "$(fm_field typecheck)"
run_check "test" "$(fm_field test)"

# ── gates declarados em FORGE.md runtime.gates (issue #82; LDG-0150) ─────────────────────────
# DUAS formas declaráveis, UM leitor só:
#
#   gates: check-authz,check-observability          # CSV escalar (forma histórica)
#   gates:                                          # block-sequence com fase (0.11.0+)
#     - check-authz                                 #   item escalar ⇒ phase: source
#     - name: check-image-digest
#       phase: pre-deploy
#
# Este bloco tinha um leitor PRÓPRIO — um `awk` bespoke que só extraía o valor escalar da linha
# `  gates:`. Com a forma mapeada, o valor inline é vazio: `GATES_CSV` ficava vazio, o laço não
# rodava, e o hook não imprimia uma linha sobre isso. Um consumidor que adotasse `phase:` —
# inclusive declarando tudo como `phase: source`, que é a fase que o push executa — deixava de
# rodar TODOS os gates no push, com o push verde. Adotar a fase DESLIGAVA a cobrança que existia
# antes. E era o terceiro clone do mesmo leitor no repositório (a classe de LDG-0014, duas
# implementações do mesmo contrato divergindo em silêncio, já materializada três vezes).
#
# Agora o hook usa `lib/forge-runtime.sh`, o mesmo leitor de `run-gates.sh` e de `spec-verify.sh`.
# "chave gates: presente" != "gates: com valor inline". A distinção é o que separa "nada
# declarado" (nenhuma linha `  gates:` — o hook não tem o que ler, e é o estado de todo projeto
# que nunca declarou gate) de "declarado numa forma que eu não consegui ler". Este awk NÃO lê os
# NOMES dos gates — isso é do leitor canônico e só dele; ele responde uma pergunta que o leitor
# canônico não expõe: a chave existe?
gates_key_present() {
  awk '
    /^runtime:/ { inblk=1; next }
    inblk && /^[a-z_]+:/ { exit }
    inblk && $0 ~ "^  gates:" { print "y"; exit }
  ' "$FORGE_MD"
}

# Valor INLINE da chave, quando há um. Usado SÓ no caminho degradado abaixo, onde o leitor
# canônico é, por definição, indisponível — não é um segundo leitor do contrato concorrendo com
# ele, é o que resta quando ele não está lá.
gates_inline_raw() {
  awk '
    /^runtime:/ { inblk=1; next }
    inblk && /^[a-z_]+:/ { exit }
    inblk && $0 ~ "^  gates:" { sub("^  gates:[[:space:]]*", ""); print; exit }
  ' "$FORGE_MD"
}

RUNTIME_LIB="$ROOT/.forge/scripts/lib/forge-runtime.sh"
if [ -n "$(gates_key_present)" ]; then
  if [ ! -f "$RUNTIME_LIB" ]; then
    # Pré-condição de DIRETÓRIO, como todas as guardas irmãs deste arquivo (AI_CHECK, ACKS,
    # HEAVY_LIB, require_hook_lib e o bloco de lints de shell) e como o comentário do topo declara:
    # "o no-op só é legítimo quando o harness NÃO está instalado — se o DIRETÓRIO que hospeda o
    # alvo existe, a ausência do alvo significa harness atualizado pela metade". Sem
    # `.forge/scripts/` não há harness instalado NESTE checkout, e não há contrato a cobrar.
    #
    # Mas alinhar não é afrouxar: com `.forge/scripts/` ausente E gates declarados INLINE, nenhum
    # dos scripts declarados pode existir, e o push é recusado do mesmo jeito — é o que o hook
    # anterior já fazia por outro caminho (o `[ -f "$gate_script" ]` do laço), e perder isso seria
    # uma regressão de cobertura disfarçada de consistência.
    if [ -d "$ROOT/.forge/scripts" ]; then
      echo "pre-push BLOQUEADO: .forge/scripts/ existe e .forge/scripts/lib/forge-runtime.sh não." >&2
      echo "  É o leitor ÚNICO de runtime.gates (o mesmo de run-gates.sh e spec-verify.sh); sem ele" >&2
      echo "  o hook não sabe o que foi declarado, e seguir devolveria zero gates com push verde." >&2
      echo "  Rode 'npx forge-harness update' ou restaure a lib." >&2
      exit 1
    fi
    _gates_inline_degraded="$(gates_inline_raw)"
    if [ -n "$_gates_inline_degraded" ]; then
      echo "pre-push BLOQUEADO: runtime.gates declara '$_gates_inline_degraded' e .forge/scripts/ não existe neste checkout." >&2
      echo "  Nenhum dos gates declarados pode estar instalado, então declarar e seguir seria" >&2
      echo "  silêncio verde sobre gate nenhum. Corrija runtime.gates ou instale o harness." >&2
      exit 1
    fi
    # NO-GATES honesto, dito em voz alta: nada declarado inline e nenhum script onde um gate
    # pudesse morar. "Não examinei" continua visível (issue #49) sem travar quem não instalou.
    echo "pre-push: runtime.gates NO-GATES — .forge/scripts/ ausente neste checkout e nenhum gate declarado inline"
  else   # leitor presente: caminho normal, com o leitor canônico
  # shellcheck disable=SC1090
  . "$RUNTIME_LIB"
  # Pelo leitor canônico, nunca por um awk local: é justamente a segunda implementação do mesmo
  # contrato que este item existe para eliminar.
  _gates_inline="$(forge_get_runtime gates "$ROOT" || true)"

  # Guarda do leitor indisponível. `forge_runtime_gate_entries` delega a forma mapeada a
  # `node lib/gate-phase.mjs` e devolve VAZIO, calada, quando node não existe — e vazio é
  # indistinguível de "nenhum gate declarado". O gatilho do bloqueio é a INDISPONIBILIDADE DO
  # LEITOR, nunca a forma do frontmatter: `  gates:` sem valor inline é o estado de FÁBRICA de
  # todo projeto novo (templates/FORGE.md), e bloquear por essa forma recusaria o primeiro push
  # de todo adotante.
  #
  # Esta guarda CONTRARIA POR DESENHO o contrato escrito de lib/forge-runtime.sh ("ausência de
  # node ⇒ a forma mapeada simplesmente não é lida … nunca trava o script"). A severidade é do
  # CHAMADOR, e o hook é o chamador que bloqueia: `run-gates.sh` e `spec-verify.sh` seguem
  # silenciosos no mesmo estado. Duas severidades para o mesmo fato, declaradas — o inaceitável
  # seria ficarem implícitas.
  if [ -z "$_gates_inline" ]; then
    if ! command -v node >/dev/null 2>&1 || [ ! -f "$ROOT/.forge/scripts/lib/gate-phase.mjs" ]; then
      echo "pre-push BLOQUEADO: 'runtime.gates' está declarado sem valor inline (forma mapeada) e a declaração NÃO PÔDE SER LIDA." >&2
      command -v node >/dev/null 2>&1 \
        || echo "  Causa: 'node' não está no PATH — a forma mapeada é lida por lib/gate-phase.mjs." >&2
      [ -f "$ROOT/.forge/scripts/lib/gate-phase.mjs" ] \
        || echo "  Causa: .forge/scripts/lib/gate-phase.mjs ausente — rode 'npx forge-harness update'." >&2
      echo "  Não bloquear aqui devolveria ZERO gates e um push verde, indistinguível de um projeto" >&2
      echo "  sem gate algum. Instale o leitor, ou declare os gates na forma CSV escalar." >&2
      exit 1
    fi
  fi

  _gate_entries="$(forge_runtime_gate_entries "$ROOT" || true)"
  _src_gates="$(printf '%s\n' "$_gate_entries" | awk -F'\t' '$2=="source" && $1!=""{print $1}')"
  _n_all=0; _n_src=0
  [ -z "$_gate_entries" ] || _n_all="$(printf '%s\n' "$_gate_entries" | grep -c . || true)"
  [ -z "$_src_gates" ] || _n_src="$(printf '%s\n' "$_src_gates" | grep -c . || true)"

  if [ "$_n_all" -eq 0 ]; then
    # NO-GATES declarado em voz alta: "não examinei" e "examinei e estava limpo" não podem
    # terminar no mesmo silêncio (issue #49).
    echo "pre-push: runtime.gates NO-GATES — 0 gate(s) declarado(s) no FORGE.md"
  elif [ "$_n_src" -eq 0 ]; then
    _other_phases="$(printf '%s\n' "$_gate_entries" | awk -F'\t' '$1!=""{print $2}' | sort -u | tr '\n' ' ')"
    echo "pre-push: runtime.gates — $_n_all gate(s) declarado(s), 0 de fase 'source'; o push não executa fase(s): ${_other_phases% }"
  else
    echo "pre-push: runtime.gates — $_n_src gate(s) de fase 'source' de $_n_all declarado(s)"
    while IFS= read -r gate; do
      [ -n "$gate" ] || continue
      gate_script="$ROOT/.forge/scripts/${gate}.sh"
      if [ -f "$gate_script" ]; then
        run_check "$gate" "bash '$gate_script' --path '$ROOT'"
      else
        # Era `skip` com exit 0 — declarar um gate e ele não existir virava silêncio verde, a forma
        # exata do risco que a issue #49 descreve. `run-gates.sh` já tratava isso como MISSING e
        # reprovava; o hook estava fora de sincronia com o próprio harness.
        echo "pre-push BLOQUEADO: gate '$gate' declarado em runtime.gates e $gate_script não existe." >&2
        echo "  Declarar e não existir é delegação em alvo ausente — corrija runtime.gates ou instale o gate." >&2
        exit 1
      fi
    done <<EOF_GATES
$_src_gates
EOF_GATES
    fi
  fi
fi

# ── rede de suítes do harness (issue #49, instância 2) ───────────────────────────────────────
# Um gate entregue e nunca chamado conta como cobertura nos relatórios e não cobre nada: no
# axis-device-platform, `grep -rn "run-all.sh" .github .forge/hooks .forge/FORGE.md` devolvia
# vazio, e doze suítes de guarda só rodavam por invocação manual. O template não fiava a rede em
# ponto de entrada algum — todo projeto que instalava o harness herdava hooks que nunca a
# invocavam, e o consumidor axis-fare-validator teve de descobrir e consertar sozinho.
#
# O `elif` é o ponto central, e é a instância 4 aplicada à própria fiação: `[ -f ]` sozinho
# degrada em silêncio — apagar o runner deixaria o hook verde sem uma linha. A existência do
# DIRETÓRIO de suítes torna a ausência do runner um ERRO.
HARNESS_SUITE="$ROOT/.forge/scripts/tests/run-all.sh"
if [ -f "$HARNESS_SUITE" ]; then
  run_check "harness-tests" "bash '$HARNESS_SUITE'"
elif [ -d "$ROOT/.forge/scripts/tests" ]; then
  echo "pre-push BLOQUEADO: .forge/scripts/tests/ existe mas run-all.sh não — a suíte do harness sumiu." >&2
  echo "  Guarda que ninguém roda não cobre nada; restaure o runner ou remova o diretório." >&2
  exit 1
fi

# ── tronco à frente do remoto (issue #67) ────────────────────────────────────────────────────────
# POR ÚLTIMO, de propósito, e não no bloco de checks baratos. Este check INFORMA, nunca bloqueia —
# então uma linha soterrada sob minutos de typecheck e test é a linha que ninguém lê. Aqui ela é a
# última coisa antes de o push prosseguir. Bônus: push já reprovado acima custa rede zero.
#
# EXECUTADO, nunca sourceado: o script usa `set -m` para dar grupo de processos próprio ao filho
# de rede, e sourceá-lo faria o job control vazar para o shell do hook.
#
# Recebe o remoto em "$1"/"$2" (que este hook não usava até agora) e o mesmo stdin de refs, porque
# medir sempre `origin` erraria em `git push outro-remote` e em fluxo de fork.
PUSH_AHEAD="$ROOT/.forge/scripts/check-push-ahead.sh"
if [ -f "$PUSH_AHEAD" ]; then
  printf '%s\n' "$INPUT" | bash "$PUSH_AHEAD" "${1:-}" "${2:-}" || true
fi

echo "pre-push OK"
