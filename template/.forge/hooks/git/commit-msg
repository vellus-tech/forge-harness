#!/usr/bin/env bash
# Forge commit-msg — barra assinatura de IA antes de a mensagem virar commit.
#
# Este é o único ponto do fluxo em que a marca ainda pode ser removida sem custo: depois do
# commit, tirá-la exige reescrever histórico, e depois do push exige reescrever histórico
# publicado. O pre-push repete a verificação sobre o range como defesa em profundidade, para o
# caso de um commit ter nascido com --no-verify ou por uma ferramenta que ignore o hook.
#
# Barato por construção: lê um arquivo e roda um node de uma passada. Nada de rede, nada de git
# pesado — cabe no orçamento de um hook que roda a cada commit.
set -u

MSG_FILE="${1:-}"
[ -n "$MSG_FILE" ] || exit 0

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

# Resolução do alvo delegado (issue #141): core.hooksPath é gravado ABSOLUTO para o tronco
# (#41/#54, LDG-0042), mas cada worktree carrega sua PRÓPRIA cópia de .forge/scripts/ (issue
# #41). Um hook novo (vindo do tronco via hooksPath) encontra scripts antigos na worktree que o
# executa e bloqueava por causa alheia. Precedência: a árvore que executa primeiro; se o alvo
# faltar lá E a árvore do hook (o tronco, quando hooksPath é absoluto) o tiver, usa o do tronco
# com uma linha nomeando-o; bloqueio só quando falta nas duas.
HOOK_FORGE_DIR="$(cd "$(dirname "$0")/../.." 2>/dev/null && pwd)" || HOOK_FORGE_DIR=""
resolve_delegated() {  # resolve_delegated <label> <rel-sob-.forge/> — ecoa o caminho resolvido em
  # stdout; rc 0 = achado (própria árvore, ou do tronco com aviso em stderr nomeando-o); rc 1 =
  # ausente nas duas com o diretório-lar presente em ao menos uma (bloqueio é do chamador); rc 2 =
  # diretório-lar ausente nas duas (no-op legítimo — harness não instalado).
  local label="$1" rel="$2"
  local wt="$ROOT/.forge/$rel" trunk="" wt_dir trunk_dir=""
  wt_dir="$(dirname "$wt")"
  if [ -f "$wt" ]; then printf '%s\n' "$wt"; return 0; fi
  if [ -n "$HOOK_FORGE_DIR" ]; then
    trunk="$HOOK_FORGE_DIR/$rel"
    trunk_dir="$(dirname "$trunk")"
  fi
  if [ -n "$trunk" ] && [ -f "$trunk" ]; then
    # Achado LOW da correção do #141 (rodada 2): quando $ROOT/.forge não existe NADA — branch
    # anterior à adoção do harness, nunca uma worktree defasada —, não há o que "forge update"
    # atualizasse ali, e o aviso instruiria a corrigir algo que não existe. Suprimido só nesse
    # caso; o alvo do tronco continua sendo usado exatamente como antes, só a linha some.
    if [ -d "$ROOT/.forge" ]; then
      echo "hook: $label ausente em $ROOT — usando o do tronco ($trunk); rode forge update na worktree" >&2
    fi
    printf '%s\n' "$trunk"
    return 0
  fi
  if [ -d "$wt_dir" ] || { [ -n "$trunk_dir" ] && [ -d "$trunk_dir" ]; }; then
    # A recusa do CHAMADOR (texto literal, mantido) fala de UMA árvore só. Sem esta linha, uma
    # worktree que não tem sequer o DIRETÓRIO faria a mensagem afirmar, por omissão, que ele
    # existe nela — falso quando só o tronco o tem. Nomear as duas buscas não muda o prefixo que
    # gates e usuários casam, só acrescenta onde se procurou.
    echo "  (procurado em $wt_dir e em ${trunk_dir:-<tronco indisponível>})" >&2
    return 1
  fi
  return 2
}

# Regra de delegação (issue #49, instância 4): chamar algo que não existe é ERRO, não no-op.
# O no-op só é legítimo quando o harness NÃO está instalado — aí não há maquinaria a impor. Se o
# DIRETÓRIO que hospeda o alvo existe, a ausência do alvo significa harness atualizado pela
# metade, script apagado ou instalação corrompida, e isso não pode terminar no mesmo desfecho de
# uma execução bem-sucedida.
CHECK="$(resolve_delegated check-ai-attribution.sh scripts/check-ai-attribution.sh)"; _rc=$?
if [ "$_rc" -eq 2 ]; then exit 0; fi
if [ "$_rc" -eq 1 ]; then
  echo "commit-msg BLOQUEADO: .forge/scripts/ existe mas check-ai-attribution.sh não —" >&2
  echo "  a delegação aponta para um alvo ausente. Rode /forge:upgrade ou restaure o script." >&2
  exit 1
fi

if ! bash "$CHECK" msg-file "$MSG_FILE"; then
  echo "commit-msg BLOQUEADO: no-ai-attribution" >&2
  exit 1
fi
exit 0
