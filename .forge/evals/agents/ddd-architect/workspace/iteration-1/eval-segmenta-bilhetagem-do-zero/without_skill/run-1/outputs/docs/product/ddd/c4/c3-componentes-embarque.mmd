    end

    VALIDADOR["Validador embarcado (cliente)"]
    CARTEIRA_SVC["carteira-svc"]
    CADASTRO_SVC["cadastro-linhas-svc"]
    FILA[("RabbitMQ")]

    VALIDADOR -- "cartão + linha" --> API
    API --> MOTOR
    MOTOR -- "consulta saldo/bloqueio" --> PROJ
    MOTOR -- "consulta tarifa vigente/janela" --> PROJ
    CARTEIRA_SVC -. "sincroniza projeção" .-> PROJ
    CADASTRO_SVC -. "sincroniza tarifas/linhas" .-> PROJ
    MOTOR --> REPO
