{
  "vhosts": [{ "name": "liquidacao" }],
  "exchanges": [
    { "name": "pagamentos.eventos", "vhost": "liquidacao", "type": "topic", "durable": true, "auto_delete": false, "arguments": {} },
    { "name": "liquidacao.dlx", "vhost": "liquidacao", "type": "direct", "durable": true, "auto_delete": false, "arguments": {} }
  ],
  "queues": [
    {
      "name": "liquidacao.lancamentos",
      "vhost": "liquidacao",
      "durable": true,
      "auto_delete": false,
      "arguments": { "x-queue-type": "quorum", "x-single-active-consumer": true }
    },
    {
      "name": "liquidacao.parking",
      "vhost": "liquidacao",
      "durable": true,
      "auto_delete": false,
      "arguments": { "x-queue-type": "quorum" }
    }
  ],
  "bindings": [
    { "source": "pagamentos.eventos", "vhost": "liquidacao", "destination": "liquidacao.lancamentos", "destination_type": "queue", "routing_key": "lancamento.#", "arguments": {} },
    { "source": "liquidacao.dlx", "vhost": "liquidacao", "destination": "liquidacao.parking", "destination_type": "queue", "routing_key": "", "arguments": {} }
  ],
  "policies": [
    {
      "vhost": "liquidacao",
      "name": "liquidacao-lancamentos",
      "pattern": "^liquidacao\\.lancamentos$",
      "apply-to": "quorum_queues",
      "priority": 1,
      "definition": {
        "delivery-limit": 5,
        "max-length": 200000,
        "overflow": "reject-publish",
        "dead-letter-exchange": "liquidacao.dlx",
        "dead-letter-strategy": "at-least-once"
      }
    }
  ]
}
